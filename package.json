{
  "name": "scrollect",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "convex": "^1.33.1",
      "better-auth": "1.5.6",
      "@convex-dev/better-auth": "^0.11.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=!@scrollect/native",
    "build": "turbo build",
    "dev:native": "turbo -F @scrollect/native dev",
    "dev:web": "turbo -F @scrollect/web dev",
    "dev:server": "turbo -F @scrollect/backend dev",
    "dev:setup": "turbo -F @scrollect/backend dev:setup",
    "check": "oxlint && oxfmt --write",
    "test:e2e": "turbo -F @scrollect/e2e test:e2e",
    "capture:og": "bun run scripts/capture-og-image.ts"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@scrollect/env": "workspace:*",
    "convex": "^1.33.1",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@scrollect/config": "workspace:*",
    "lefthook": "^2.0.13",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.3"
}
